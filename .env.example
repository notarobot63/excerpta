# Session secret. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

# Full public URL of the instance, scheme and port included.
# Only this hostname is accepted; requests with any other Host are rejected.
BASE_URL=http://localhost:8070

# Extra hostnames allowed to reach the instance, comma separated.
# EXTRA_ALLOWED_HOSTS=links.example.org,links.example.net

# OIDC provider. There is no local password login.
OIDC_CLIENT_ID=your-pocketid-client-id
OIDC_CLIENT_SECRET=your-pocketid-client-secret
OIDC_ISSUER=https://auth.example.com

# How often starred FreshRSS articles are pulled, in minutes.
FRESHRSS_SYNC_INTERVAL=30

# Secure flag on the session cookie (default: true).
# Set to false ONLY for plain-HTTP access on a local network, where the
# Secure flag would otherwise make signing in impossible.
# SESSION_COOKIE_SECURE=true

# Only grant the admin role when the identity provider reports the email as
# verified (default: true). Turn this off if your provider does not emit
# the email_verified claim.
# REQUIRE_VERIFIED_EMAIL=true
